import java.util.Random;
import java.util.Scanner;

public class cidadeChuva {
    static void main() {
        int somaDosRms = 0;

        Scanner sc = new Scanner(System.in);
        Random gerador = new Random(somaDosRms);

        int[] rms = new int[3];
        int[] parametros = new int[5];


        System.out.println("Quantos integrantes possuem na equipe?");
        int integrantes = sc.nextInt();

        for (int i = 1; i <= integrantes; i++){
            System.out.println("Informe o RM do participante: " + i);
            rms[i-1] = sc.nextInt();
        }

        somaDosRms = calcularRmEquipe(rms);
        parametros = calcularParametros(somaDosRms);

        int[][] altitude = new int[parametros[0]][parametros[1]];
        altitude = gerarAltitude(gerador,parametros[0],parametros[1]);

        int[][] lamina = new int[parametros[0]][parametros[1]];
        lamina = gerarMatriz(gerador,parametros[0],parametros[1],0,10);

        imprimir(altitude, "Altitude:");
        imprimir(lamina, "Lâmina:");
        somar(altitude);

        int[] direcaoLinha = criarDeslocamentoLinha(parametros[4]);
        int[] direcaoColuna = criarDeslocamentoColuna(parametros[4]);
        simularPasso(altitude,lamina,direcaoLinha,direcaoColuna);

    }

    static int calcularRmEquipe(int[] rms) {
        int somaDosRms = 0;
        for (int i = 0; i < rms.length; i++){
            somaDosRms += rms[i];
        }
        return somaDosRms;
    }

    static int[] calcularParametros(int rm){
        int[] parametros = new int[5];

        parametros[0] = 8 + rm % 3; //Valor N
        parametros[1] = 10 + (rm / 10) % 3; //Valor M
        parametros[2] = 4 + (rm / 100) % 3; //Valor K
        parametros[3] = 10 + 2 * (rm % 4); //Valor L
        parametros[4] = rm % 2; //Valor ordem

        for (int i = 0; i < parametros.length; i++){
            System.out.println(parametros[i]);
        }

        return parametros;
    }

    static int[][] gerarAltitude(Random gerador, int n, int m){
        int[][] altitude = new int[n][m];
        for (int i = 0; i < n; i++){
            for (int j = 0; j < m; j++){
                altitude[i][j] = 3 * Math.abs(i - n / 2) + Math.abs(gerador.nextInt(5));
            }
        }
        return altitude;

    }

    static int[][] gerarMatriz(Random gerador, int n, int m, int minimo, int maximo){
        int[][] lamina = new int [n][m];
        for (int i = 0; i < n; i++){
            for (int j = 0; j < m; j++){
                lamina[i][j] = minimo + gerador.nextInt(maximo - minimo + 1);
            }
        }
        return lamina;
    }

    static int[] criarDeslocamentoLinha(int ordem){
        int[] ordem0 = {-1, 0, 1, 0};
        int[] ordem1 = {0, 1, 0, -1};

        if (ordem == 0){
            return ordem0;
        } else {
           return ordem1;
        }
    }

    static int[] criarDeslocamentoColuna(int ordem){
        int[] coluna0 = {0, 1, 0, -1};
        int[] coluna1 = {-1, 0, 1, 0};

        if (ordem == 0){
            return coluna0;
        } else {
            return coluna1;
        }
    }

    static boolean dentro(int i, int j, int n, int m){
        return i >= 0 && i <= n && j >= 0 && j <= m;
    }

    static int[][] copiar(int[][] matriz){
        int[][] copia = new int[matriz.length][matriz[0].length];

        for (int i = 0; i < matriz.length; i++){
            for (int j = 0; j < matriz[0].length; j++){
                copia[i][j] = matriz[i][j];
            }
        }
        return copia;
    }

    static void imprimir(int[][] matriz, String titulo){
        System.out.println(titulo);

        for (int[] linha : matriz) {
            for (int elemento : linha) {
                System.out.print(elemento + "\t");
            }
            System.out.println();
        }
    }

    static int somar(int[][] matriz){
        int somar = 0;

        for (int[] linha : matriz) {
            for (int elemento : linha) {
                somar += elemento;
                System.out.println(somar);
            }
        }
        return somar;
    }

    static int nivel(int[][] altitude, int[][] lamina, int i, int j){
        return altitude[i][j] + lamina[i][j];
    }

    static int[][] simularPasso(int[][] altitude, int[][] lamina, int[] deslocamentoLinha, int[] deslocamentoColuna){
        int[][] nova = copiar(lamina);
        int nivelAtual = 0;
        int menorNivel;
        int menorVizinhoI = 0;
        int menorVizinhoJ = 0;

        for (int i = 0; i < lamina.length; i++){
            for (int j = 0; j < lamina[0].length; j++){
                nivelAtual = nivel(altitude, lamina, i, j);
                menorNivel = nivelAtual;
                for (int d = 0; d <= 3; d++){

                    if (dentro(i + deslocamentoLinha[d], j + deslocamentoColuna[d], lamina.length, lamina[0].length)){
                        int nivelVizinho = nivel(altitude, lamina,i + deslocamentoLinha[d], j + deslocamentoColuna[d]);
                        if (nivelVizinho < menorNivel){
                            menorNivel = nivelVizinho;
                        }
                    }
                }

            }
        }
    }


}

